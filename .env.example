# Purvai Environment Configuration
# Copy to .env for local development. Never commit .env or put secrets in frontend files.

PURVAI_MODE=local                  # Execution mode: "local" (persistent SQLite) or "demo" (temporary DB)
DATABASE_PATH=                     # Optional DB path relative to repo root (defaults: data/purvai.db or OS temp)
DATA_GOV_IN_API_KEY=               # Official CPCB data.gov.in API key (optional in Phase 1; required in Phase 2)
CPCB_TIMEOUT_S=20                  # Overall CPCB station-list refresh timeout in seconds (5 to 60)
PURVAI_FAKE_PROVIDERS=false        # Test-only local fixture seam (refused when PURVAI_MODE=demo)
CO2_ESTIMATES_ENABLED=true         # Enable lifecycle CO2 savings estimates
TRUST_PROXY_HEADERS=false          # Set true behind a reverse proxy (Cloud Run / Render)
AI_PROVIDER=gemini                 # Primary AI provider identifier
AI_MODEL=                          # Optional override (defaults to gemini-3.5-flash-lite)
AI_FALLBACK_PROVIDER=groq          # Fallback AI provider identifier
AI_FALLBACK_MODEL=openai/gpt-oss-20b  # Fallback AI model ID
AI_TIMEOUT_S=15                    # AI call timeout in seconds (5 to 30)
GEMINI_API_KEY=                    # Gemini API key from Google AI Studio (never commit)
GROQ_API_KEY=                      # Groq API key (never commit)
CORS_DEV_ORIGIN=http://localhost:5173  # Allowed dev frontend origin in local mode
LOG_LEVEL=INFO                     # Backend log level (DEBUG, INFO, WARNING, ERROR)
