# Purvai Environment Configuration
# Copy to .env for local development. Never commit .env or put secrets in frontend files.

PURVAI_MODE=local                  # Execution mode: "local" (persistent SQLite) or "demo" (temporary DB)
DATABASE_PATH=                     # Optional DB path relative to repo root (defaults: data/purvai.db or OS temp)
DATA_GOV_IN_API_KEY=               # Official CPCB data.gov.in API key (optional in Phase 1; required in Phase 2)
AI_PROVIDER=gemini                 # Primary AI provider identifier (unused in Phase 1)
AI_MODEL=                          # Primary AI model ID (unused in Phase 1)
AI_FALLBACK_PROVIDER=groq          # Fallback AI provider identifier (unused in Phase 1)
AI_FALLBACK_MODEL=openai/gpt-oss-20b  # Fallback AI model ID (unused in Phase 1)
GEMINI_API_KEY=                    # Gemini API key from Google AI Studio (optional in Phase 1)
GROQ_API_KEY=                      # Groq API key (optional in Phase 1)
CORS_DEV_ORIGIN=http://localhost:5173  # Allowed dev frontend origin in local mode
LOG_LEVEL=INFO                     # Backend log level (DEBUG, INFO, WARNING, ERROR)
